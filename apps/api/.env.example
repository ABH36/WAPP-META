# Copy to .env and fill in real values locally. Never commit .env (TAD-001 SEC-007 / DEP-005).

NODE_ENV=development
PORT=4000

# Database (SAD-002 §2) — local dev points at the docker-compose mongo container;
# staging/production point at real MongoDB Atlas. `replicaSet=rs0` matches
# the single-node replica set docker-compose.yml's `mongo`/`mongo-init`
# services stand up locally — required for multi-document transactions
# (docs/ADR-INFRA-001-mongo-replica-set-strategy.md).
MONGODB_URI=mongodb://localhost:27017/wapp_dev?replicaSet=rs0

# Cache / Queue (TAD-001 §4)
REDIS_URL=redis://localhost:6379

# Authentication (TAD-001 §11, AUTH-001–005) — generate strong random values,
# never reuse across environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Platform Administration (PRD-007 Volume-1) — a completely separate secret
# pair from tenant JWT_ACCESS_SECRET/JWT_REFRESH_SECRET above. Never reuse
# the same value across the two pairs, even in dev.
PLATFORM_JWT_ACCESS_SECRET=
PLATFORM_JWT_REFRESH_SECRET=
PLATFORM_JWT_ACCESS_TTL=15m
PLATFORM_JWT_REFRESH_TTL=30d

BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_HISTORY_LIMIT=5

# Email (TAD-001 v1.2 Email Patch — Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@wapp.example
RESEND_FROM_NAME=WAPP
EMAIL_VERIFICATION_TOKEN_TTL=60
PASSWORD_RESET_TOKEN_TTL=30
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=

# Workspace & Tenant Management (D007 trial term, Team Invitation)
TRIAL_DURATION_DAYS=14
TEAM_INVITATION_TOKEN_TTL_DAYS=7

# Storage (TAD-001 §4 — Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS allow-list (SEC-010) — the two frontend origins this API accepts requests from.
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Meta WhatsApp Cloud API (PRD-003 Part 1) — WAPP's own Tech Provider app
# (D004 — customers connect their own WABA via Embedded Signup using this
# app; WAPP never owns customer WABAs/phone numbers).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# 64-char hex (32 bytes) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts WABA access tokens at rest (TAD-001 SEC-007). Rotating this key
# invalidates every stored token — reconnecting each workspace's WABA is
# the only recovery path, so treat it like any other long-lived secret.
TOKEN_ENCRYPTION_KEY=

# Optional — `Domain` attribute for the httpOnly refresh-token cookie.
# Required in production only for apps/admin's separate subdomain (PHD-001
# Volume-1). Leave unset in dev.
COOKIE_DOMAIN=

# Observability (PHD-001 Volume-2) — shared secret protecting GET /metrics
# (a Prometheus-style scraper can't do interactive JWT login). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_AUTH_TOKEN=

# Baked in at Docker build time (docker/api.Dockerfile build args); left
# unset in local dev, where "unknown" is the honest fallback.
BUILD_VERSION=
GIT_COMMIT=

# Optional — OpenTelemetry's own standard env vars, read directly by the SDK
# (see tracing.ts). Unset in dev: traces render to the console instead.
# Unset in production: tracing stays fully inert (zero overhead) until an
# endpoint is configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wapp-api
