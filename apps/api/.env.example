# Copy to .env and fill in real values locally. Never commit .env (TAD-001 SEC-007 / DEP-005).

NODE_ENV=development
PORT=4000

# Database (SAD-002 §2) — local dev points at the docker-compose mongo container;
# staging/production point at real MongoDB Atlas.
MONGODB_URI=mongodb://localhost:27017/wapp_dev

# Cache / Queue (TAD-001 §4)
REDIS_URL=redis://localhost:6379

# Authentication (TAD-001 §11, AUTH-001–005) — generate strong random values,
# never reuse across environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Email (TAD-001 v1.2 Email Patch — Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@wapp.example
RESEND_FROM_NAME=WAPP
EMAIL_VERIFICATION_TOKEN_TTL=60
PASSWORD_RESET_TOKEN_TTL=30
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=

# Workspace & Tenant Management (D007 trial term, Team Invitation)
TRIAL_DURATION_DAYS=14
TEAM_INVITATION_TOKEN_TTL_DAYS=7

# Storage (TAD-001 §4 — Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS allow-list (SEC-010) — the two frontend origins this API accepts requests from.
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Meta WhatsApp Cloud API (PRD-003 Part 1) — WAPP's own Tech Provider app
# (D004 — customers connect their own WABA via Embedded Signup using this
# app; WAPP never owns customer WABAs/phone numbers).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# 64-char hex (32 bytes) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts WABA access tokens at rest (TAD-001 SEC-007). Rotating this key
# invalidates every stored token — reconnecting each workspace's WABA is
# the only recovery path, so treat it like any other long-lived secret.
TOKEN_ENCRYPTION_KEY=
