{
  "name": "@wapp/api",
  "version": "0.1.0",
  "private": true,
  "description": "WAPP backend — NestJS, TypeScript, Modular Monolith (SAD-001)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wapp/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/jwt": "^10.2.0",
    "bullmq": "^5.21.2",
    "mongoose": "^8.8.0",
    "ioredis": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "resend": "^4.0.1",
    "cloudinary": "^2.5.1",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "pino": "^9.5.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@wapp/config": "workspace:*",
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
