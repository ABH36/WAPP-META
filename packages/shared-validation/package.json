{
  "name": "@wapp/shared-validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared validation rules (Zod) consumed by both frontend forms (React Hook Form) and backend DTOs, so a business rule like phone-number or GSTIN format is defined exactly once.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@wapp/config": "workspace:*",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
